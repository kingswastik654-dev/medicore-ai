# Copy to .env and adjust. All vars optional with sane dev defaults.
# Database: SQLite default; use the docker-compose Postgres in team dev.
MEDCORE_DATABASE_URL=postgresql://medcore:medcore@localhost:5432/medcore

# Security — MUST be changed for anything beyond local development (32+ chars).
MEDCORE_SECRET_KEY=change-me-to-a-long-random-secret-value

# Token lifetime (minutes)
MEDCORE_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated browser origins allowed by CORS (JSON array syntax)
# MEDCORE_CORS_ORIGINS=["http://localhost:3000"]

# Set false in production after first provisioning
MEDCORE_AUTO_SEED=true
